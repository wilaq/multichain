// Headers for the asset canister. Without this file dfx serves the app with no
// CSP and no framing protection at all — on a page that collects legal names and
// DOBs and triggers wallet signature prompts, clickjacking a signature dialog is
// the concrete risk.
//
// `connect-src` is generated from the RPC pools in src/lib/wagmi.ts — if you add
// an RPC endpoint there, add its origin here too or the browser will block it.
[
  {
    "match": "**/*",
    "headers": {
      "Content-Security-Policy": "default-src 'self';script-src 'self' 'unsafe-eval';style-src 'self' 'unsafe-inline';font-src 'self';img-src 'self' data: blob:;connect-src 'self' https://icp0.io https://*.icp0.io https://ic0.app https://*.ic0.app https://id.ai https://*.id.ai wss://relay.walletconnect.com https://*.walletconnect.com https://*.walletconnect.org https://1rpc.io https://bsc-dataseed.binance.org https://bsc-dataseed1.binance.org https://bsc-dataseed1.defibit.io https://bsc-dataseed1.ninicoin.io https://bsc-dataseed2.binance.org https://bsc-dataseed2.defibit.io https://bsc-dataseed2.ninicoin.io https://bsc-dataseed3.binance.org https://bsc-dataseed4.binance.org https://bsc.api.onfinality.io https://bsc.drpc.org https://bsc.publicnode.com https://canto-rpc.ansybl.io https://canto.evm.chandrastation.com https://canto.gravitychain.io https://canto.slingshot.finance https://cloudflare-eth.com https://eth-mainnet.public.blastapi.io https://eth-pokt.nodies.app https://eth.api.onfinality.io https://eth.drpc.org https://eth.llamarpc.com https://eth.merkle.io https://ethereum.publicnode.com https://jsonrpc.canto.nodestake.top https://mainnet.gateway.tenderly.co https://mainnode.plexnode.org:8545 https://polygon-bor-rpc.publicnode.com https://polygon-mainnet.public.blastapi.io https://polygon-pokt.nodies.app https://polygon-rpc.com https://polygon.api.onfinality.io https://polygon.drpc.org https://polygon.llamarpc.com https://polygon.publicnode.com https://rpc.ankr.com https://rpc.flashbots.net https://rpc.mevblocker.io https://rpc.payload.de;frame-src 'self' https://id.ai https://*.id.ai;form-action 'self';base-uri 'self';object-src 'none';frame-ancestors 'none';upgrade-insecure-requests;",
      "X-Frame-Options": "DENY",
      "X-Content-Type-Options": "nosniff",
      "Referrer-Policy": "same-origin",
      "Permissions-Policy": "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()",
      "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
    }
  }
]
